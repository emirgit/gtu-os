Begin Instruction Section
0 SET 0 54      # I = 0
1 CPY 50 57     # TEMP1 = N
2 CPY 54 58     # TEMP2 = I
3 SUBI 57 58    # TEMP2 = N - I
4 JIF 58 21     # If (N-I) <= 0, jump to LOOP_END
5 CPY 52 55     # TEMP_CURRENT_ADDR = ARRAY_BASE
6 ADDI 54 55    # TEMP_CURRENT_ADDR = ARRAY_BASE + I
7 CPYI 55 56    # TEMP_CURRENT_VAL = array[I]
8 CPY 51 57     # TEMP1 = KEY
9 CPY 56 58     # TEMP2 = array[I]
10 SUBI 57 58   # TEMP2 = KEY - array[I]
11 JIF 58 14    # If (KEY - array[I]) <= 0, jump to check less_than_or_equal
12 SET 19 0     # KEY > array[I], so jump to INCREMENT_I
13 SET 21 0     # Should not be reached, but safety HLT (or jump to LOOP_END)
14 CPY 58 57    # TEMP1 = KEY - array[I]
15 ADD 57 1     # TEMP1 = (KEY - array[I]) + 1
16 JIF 57 19    # If (KEY-array[I]+1) <= 0 (means KEY < array[I]), jump to INCREMENT_I
17 CPY 54 53    # RESULT = I (Match found!)
18 SET 21 0     # Jump to LOOP_END
19 ADD 54 1     # I = I + 1
20 SET 1 0      # Jump to LOOP_START
21 HLT
End Instruction Section